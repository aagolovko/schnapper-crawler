{
    "name": "schnapper-crawler",
    "version": "0.0.1",
    "type": "module",
    "description": "This is an example of a Crawlee project.",
    "dependencies": {
        "apify": "^3.1.7",
        "crawlee": "^3.4.0",
        "dotenv-flow": "^4.1.0",
        "geojson": "^0.5.0",
        "mongodb": "^5.6.0",
        "node-fetch": "^3.3.2",
        "node-geocoder": "^4.2.0",
        "node-html-parser": "^6.1.5",
        "playwright": "^1.35.1",
        "uuid": "^9.0.0",
        "yn": "^5.1.0"
    },
    "devDependencies": {
        "@apify/tsconfig": "^0.1.0",
        "@types/geojson": "^7946.0.10",
        "@types/node": "^18.0.0",
        "@types/node-geocoder": "^4.2.1",
        "@types/uuid": "^9.0.2",
        "ts-node": "^10.8.0",
        "typescript": "^5.0.0"
    },
    "scripts": {
    "start:local": "NODE_ENV=local node --max-old-space-size=8192 --loader ts-node/esm --no-warnings src/main.ts",
    "start:prod": "NODE_ENV=prod ts-node-esm -T src/main.ts",
    "start:dev:geolocating": "NODE_ENV=local node --loader ts-node/esm --no-warnings src/geolocating.ts",
    "build": "tsc --noEmit",
    "test": "tsc --noEmit"
  },
    "engines": {
        "node": ">=20"
    },
    "author": "nobody",
    "license": "ISC"
}
